# .ralphrc - MatMentor (Ronin) Ralph Configuration

# Project identification
PROJECT_NAME="matmentor-ronin"
PROJECT_TYPE="typescript"

# Loop settings
MAX_CALLS_PER_HOUR=100
CLAUDE_TIMEOUT_MINUTES=30
CLAUDE_OUTPUT_FORMAT="json"

# Tool permissions — unrestricted Bash (non-negotiable for overnight runs)
ALLOWED_TOOLS="Write,Read,Edit,Glob,Grep,Bash"

# Session management
SESSION_CONTINUITY=true
SESSION_EXPIRY_HOURS=24

# Task sources
TASK_SOURCES="local"

# Circuit breaker thresholds
CB_NO_PROGRESS_THRESHOLD=3
CB_SAME_ERROR_THRESHOLD=5
CB_OUTPUT_DECLINE_THRESHOLD=70
CB_COOLDOWN_MINUTES=30
CB_AUTO_RESET=false

# Advanced
CLAUDE_AUTO_UPDATE=true
RALPH_VERBOSE=false
